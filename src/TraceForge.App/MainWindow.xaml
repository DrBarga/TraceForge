<Window
    x:Class="TraceForge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TraceForge.App.ViewModels"
    Title="TraceForge">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="20,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TraceForge" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Windows Application Diagnostics" Opacity="0.65" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                <TextBlock Text="•" Opacity="0.4" />
                <TextBlock Text="{x:Bind ViewModel.LastUpdated, Mode=OneWay}" Opacity="0.7" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="20,0,20,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search process, PID or path" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" />
            <ToggleSwitch x:Name="LiveToggle" Grid.Column="2" Header="Live" IsOn="True" Toggled="LiveToggle_Toggled" />
            <Button Grid.Column="3" Content="Export report" Click="ExportReportButton_Click" />
            <Button Grid.Column="4" Content="History" Click="HistoryButton_Click" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Processes" Opacity="0.6" />
                <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="Anomalies" Opacity="0.6" />
                <TextBlock Text="{x:Bind ViewModel.AnomalyCount, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="Limited" Opacity="0.6" />
                <TextBlock Text="{x:Bind ViewModel.LimitedProcessCount, Mode=OneWay}" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="20,0,20,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,0,8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PID" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Process" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="CPU" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Memory" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Threads" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Executable" FontWeight="SemiBold" />
                    </Grid>
                    <ListView
                        x:Name="ProcessList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                        SelectionChanged="ProcessList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ProcessRowViewModel">
                                <Grid Padding="8,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Pid, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Memory, Mode=OneWay}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Threads, Mode=OneWay}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Path, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="Process details" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" FontSize="18" TextWrapping="Wrap" />
                    <Button
                        Content="Launch and watch an application"
                        HorizontalAlignment="Stretch"
                        Click="LaunchTargetButton_Click" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="PID" Opacity="0.6" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedPid, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Text="CPU" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedCpu, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Text="Parent PID" Opacity="0.6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedParentPid, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Text="Memory" Opacity="0.6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedMemory, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Text="Threads" Opacity="0.6" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedThreads, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Text="Access" Opacity="0.6" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SelectedAccess, Mode=OneWay}" />
                        <TextBlock Grid.Row="6" Text="Children" Opacity="0.6" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.SelectedChildCount, Mode=OneWay}" />
                        <TextBlock Grid.Row="7" Text="Started" Opacity="0.6" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.SelectedStartTime, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Text="Executable path" Opacity="0.6" Margin="0,8,0,0" />
                    <TextBox Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                    <Button
                        Content="Inspect threads, modules and network"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasSelectedProcess, Mode=OneWay}"
                        Click="InspectProcessButton_Click" />
                    <TextBlock Text="{x:Bind ViewModel.InspectionSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.InspectionWarnings, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" />
                    <Expander Header="Threads" IsExpanded="False">
                        <ListView ItemsSource="{x:Bind ViewModel.ThreadRows, Mode=OneWay}" MaxHeight="220" />
                    </Expander>
                    <Expander Header="Loaded modules" IsExpanded="False">
                        <ListView ItemsSource="{x:Bind ViewModel.ModuleRows, Mode=OneWay}" MaxHeight="260" />
                    </Expander>
                    <Expander Header="TCP and UDP endpoints" IsExpanded="False">
                        <ListView ItemsSource="{x:Bind ViewModel.ConnectionRows, Mode=OneWay}" MaxHeight="260" />
                    </Expander>
                    <Button
                        Content="Capture MiniDump"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasSelectedProcess, Mode=OneWay}"
                        Click="CaptureDumpButton_Click" />
                    <Button
                        Content="Watch selected process"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasSelectedProcess, Mode=OneWay}"
                        Click="WatchProcessButton_Click" />
                    <Button
                        Content="Stop watching"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.IsWatching, Mode=OneWay}"
                        Click="StopWatchingButton_Click" />
                    <TextBlock Text="Process watch" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.WatchedProcessStatus, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="Latest exit" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.LastIncidentSummary, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="3" Margin="20,0,20,16" IsOpen="False" IsClosable="True" />
    </Grid>
</Window>
